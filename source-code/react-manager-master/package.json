{
  "name": "react-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src demos --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src demos --ext .ts,.tsx --fix --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:stg": "tsc && vite build --mode stag",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "demo:stage-1": "vite --host 127.0.0.1 --open /demos/stage-1/index.html",
    "demo:stage-2": "vite --host 127.0.0.1 --open /demos/stage-2/index.html",
    "demo:stage-3": "vite --host 127.0.0.1 --open /demos/stage-3/index.html",
    "demo:stage-4": "vite --host 127.0.0.1 --open /demos/stage-4/index.html",
    "demo:stage-5": "vite --host 127.0.0.1 --open /demos/stage-5/index.html",
    "demo:stage-6": "vite --host 127.0.0.1 --open /demos/stage-6/index.html",
    "demo:stage-7": "vite --host 127.0.0.1 --open /demos/stage-7/index.html",
    "demo:stage-8": "vite --host 127.0.0.1 --open /demos/stage-8/index.html"
  },
  "dependencies": {
    "@ant-design/icons": "^5.1.4",
    "ahooks": "^3.7.7",
    "antd": "^5.6.1",
    "axios": "^1.4.0",
    "echarts": "^5.4.2",
    "form-render": "^2.2.13",
    "less": "^4.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.11.0",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.1",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
