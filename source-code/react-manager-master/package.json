{
  "name": "react-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src demos --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src demos --ext .ts,.tsx --fix --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:stg": "tsc && vite build --mode stag",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tutorial": "vite --host 127.0.0.1 --port 5173 --open /docs/tutorial/index.html",
